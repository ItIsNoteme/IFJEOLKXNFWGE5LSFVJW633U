<!DOCTYPE html>
<html lang="en">
<head>
  <!--
    The head section defines the page metadata and the CSS styling.
    This is where the desktop appearance, window visuals, animations, and layout rules are set.
  -->
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>ARG Desktop</title>
  <style>
    /*
      This CSS variable block creates the color palette for the entire interface.
      It gives the desktop a Windows XP-inspired look with blue, gray, and white tones.
      Each variable stores a reusable color so the design stays consistent across the page.
    */
    :root {
      --xp-blue: #0a5ad3;
      --xp-blue-dark: #0c3c8d;
      --xp-teal: #3f7ec2;
      --xp-surface: #d9d9d9;
      --xp-panel: #efefef;
      --xp-menu: #f0f0f0;
      --xp-text: #0f0f0f;
      --xp-shadow: rgba(0,0,0,0.28);
      --xp-taskbar: #e8e8e8;
      --xp-button-light: #ffffff;
      --xp-button-dark: #b7b7b7;
      --xp-button-mid: #d7d7d7;
      --xp-accent: #e1f0ff;
      --wp1: linear-gradient(180deg, #5b92d1 0%, #7293c8 25%, #87b3d7 58%, #7ea3d0 100%);
    }

    /*
      Global reset: this makes box sizing consistent for all elements.
      It prevents padding or borders from making elements wider than expected.
    */
    * { box-sizing: border-box; }

    /*
      Animation keyframes define smooth motion for windows, menus, icons, and map elements.
      These make the interface feel alive and more like a desktop app or game UI.
    */
    @keyframes windowOpen {
      0% {
        opacity: 0;
        transform: translateY(12px) scale(0.97);
      }
      100% {
        opacity: 1;
        transform: translateY(0) scale(1);
      }
    }

    @keyframes menuOpen {
      0% {
        opacity: 0;
        transform: translateY(16px) scaleY(0.92);
      }
      100% {
        opacity: 1;
        transform: translateY(0) scaleY(1);
      }
    }

    @keyframes iconFloat {
      0%, 100% { transform: translateY(0px); }
      50% { transform: translateY(-2px); }
    }

    @keyframes pulseGlow {
      0%, 100% { box-shadow: 0 0 0 rgba(84, 155, 255, 0.2); }
      50% { box-shadow: 0 0 16px rgba(84, 155, 255, 0.26); }
    }

    @keyframes mapBob {
      0%, 100% { transform: translate(-50%, -50%) translateY(0); }
      50% { transform: translate(-50%, -50%) translateY(-5px); }
    }

    @keyframes barLoad {
      0% { width: 42%; }
      100% { width: 78%; }
    }

    /*
      Base page styling: this creates the full-screen desktop canvas.
      The body uses a blue gradient background and hides overflow so the app behaves like a desktop.
    */
    html, body {
      margin: 0;
      width: 100%;
      height: 100%;
      overflow: hidden;
      font-family: "Tahoma", "Segoe UI", sans-serif;
      color: var(--xp-text);
      background: #000;
    }

    body {
      background: var(--wp1);
      position: relative;
    }

    /*
      The desktop container is the main work area below the taskbar.
      It fills the screen and holds the background, icons, and floating windows.
    */
    .desktop {
      position: relative;
      width: 100vw;
      height: calc(100vh - 52px);
      background: inherit;
      overflow: hidden;
    }

    /*
      Desktop icon stack: these are the shortcut icons placed on the left side of the screen.
      They are arranged vertically and appear like a Windows desktop with clickable app shortcuts.
    */
    .desktop-icons {
      position: absolute;
      left: 12px;
      top: 14px;
      display: flex;
      flex-direction: column;
      gap: 10px;
      z-index: 3;
    }

    .desktop-icon {
      width: 88px;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 6px;
      padding: 6px 4px;
      border: 1px solid transparent;
      border-radius: 4px;
      color: #fff;
      cursor: pointer;
      user-select: none;
      text-shadow: 1px 1px 1px rgba(0,0,0,0.7);
      transition: transform 180ms ease, background 180ms ease, border-color 180ms ease, filter 180ms ease;
      animation: iconFloat 3s ease-in-out infinite;
    }

    .desktop-icon:hover,
    .desktop-icon.selected {
      background: rgba(255,255,255,0.08);
      border: 1px solid rgba(255,255,255,0.35);
      transform: translateY(-2px);
      filter: brightness(1.08);
    }

    /*
      Icon graphics are built with pseudo-elements, so each symbol is drawn with CSS shapes.
      This lets the interface use custom folder, document, recycle bin, computer, and globe icons without images.
    */
    .icon-graphic {
      width: 42px;
      height: 42px;
      position: relative;
      border-radius: 8px;
      box-shadow: inset 0 0 0 2px rgba(255,255,255,0.7), 0 1px 2px rgba(0,0,0,0.35);
      background: linear-gradient(180deg, #f2f2f2 0%, #d0d0d0 100%);
      display: grid;
      place-items: center;
      overflow: hidden;
    }

    .icon-graphic::before,
    .icon-graphic::after {
      content: "";
      position: absolute;
    }

    .icon-doc::before {
      width: 18px; height: 22px;
      background: linear-gradient(180deg, #fff, #e9e9e9);
      border: 1px solid rgba(0,0,0,0.3);
      border-radius: 2px;
      box-shadow: inset -10px 0 0 rgba(115, 154, 255, 0.25);
    }

    .icon-doc::after {
      width: 9px; height: 9px;
      background: #fff;
      border-left: 1px solid rgba(0,0,0,0.25);
      border-top: 1px solid rgba(0,0,0,0.25);
      right: 10px; top: 7px;
      transform: rotate(45deg);
    }

    .icon-folder::before {
      width: 28px; height: 15px;
      background: linear-gradient(180deg, #ffd98e, #f0b930);
      border-radius: 4px 4px 2px 2px;
      left: 7px; top: 12px;
    }

    .icon-folder::after {
      width: 30px; height: 20px;
      background: linear-gradient(180deg, #fddf8e, #e9b12b);
      border-radius: 5px 5px 6px 6px;
      left: 6px; top: 16px;
      box-shadow: inset 0 0 0 1px rgba(85,47,0,0.18);
    }

    .icon-computer::before {
      width: 24px; height: 18px;
      background: linear-gradient(180deg, #c4d7ff, #a4bfe8);
      border: 1px solid rgba(0,0,0,0.4);
      border-radius: 2px;
      top: 10px;
    }

    .icon-computer::after {
      width: 28px; height: 5px;
      background: #a9b7cf;
      border-radius: 2px;
      bottom: 9px;
      left: 7px;
      box-shadow: 0 8px 0 -2px #8998af;
    }

    .icon-bin::before {
      width: 18px; height: 20px;
      background: linear-gradient(180deg, #d4d4d4, #b6b6b6);
      border-radius: 3px 3px 4px 4px;
      top: 11px;
    }

    .icon-bin::after {
      width: 22px; height: 5px;
      background: #b5b5b5;
      border-radius: 3px;
      top: 8px;
      left: 10px;
      box-shadow: 0 0 0 2px rgba(255,255,255,0.2);
    }

    .icon-globe::before {
      width: 22px; height: 22px;
      border: 2px solid #6397ce;
      border-radius: 50%;
    }

    .icon-globe::after {
      width: 22px; height: 22px;
      border: 2px solid #6397ce;
      border-radius: 50%;
      transform: rotate(90deg);
      box-shadow: inset 0 0 0 2px rgba(255,255,255,0.15);
    }

    .desktop-icon span {
      display: block;
      font-size: 12px;
      line-height: 1.2;
      text-align: center;
      word-break: break-word;
    }

    /*
      The taskbar is the bottom bar that acts like the Windows Start bar.
      It holds the Start button, open app buttons, and the digital clock.
    */
    .taskbar {
      position: relative;
      width: 100vw;
      height: 52px;
      display: flex;
      align-items: stretch;
      padding: 0 6px 0 0;
      background: linear-gradient(180deg, #f0f0f0 0%, #d9d9d9 35%, #c6c6c6 100%);
      border-top: 1px solid rgba(255,255,255,0.85);
      box-shadow: inset 0 1px 0 #fff, 0 -1px 0 rgba(0,0,0,0.2);
      z-index: 50;
    }

    .start-button {
      position: relative;
      display: flex;
      align-items: center;
      justify-content: center;
      width: 118px;
      height: calc(100% - 4px);
      margin: 2px 4px 2px 2px;
      background: linear-gradient(180deg, #45c64c 0%, #2c9a3a 100%);
      border-top: 1px solid #a4f5a4;
      border-left: 1px solid #b9f9bb;
      border-right: 1px solid #195f2d;
      border-bottom: 1px solid #195f2d;
      color: #fff;
      font-weight: 700;
      font-size: 14px;
      cursor: pointer;
      box-shadow: inset 0 1px 0 rgba(255,255,255,0.42);
      text-shadow: 1px 1px 0 rgba(0,0,0,0.45);
      user-select: none;
    }

    .start-button::before {
      content: "";
      width: 18px; height: 18px;
      margin-right: 8px;
      background: linear-gradient(180deg, #fff, #d9d9d9);
      clip-path: polygon(0 0, 100% 0, 100% 100%, 0 100%);
      border-radius: 2px 2px 0 0;
      box-shadow: inset 0 0 0 2px rgba(0,0,0,0.4);
      position: relative;
    }

    .start-button:hover { filter: brightness(1.05); }

    .taskbar-buttons {
      display: flex;
      flex: 1;
      min-width: 0;
      align-items: center;
      gap: 4px;
      padding: 5px 0;
    }

    .taskbar-btn {
      height: 100%;
      min-width: 148px;
      max-width: 200px;
      border: 1px solid #9b9b9b;
      background: linear-gradient(180deg, #f5f5f5 0%, #d8d8d8 100%);
      padding: 0 10px;
      display: flex;
      align-items: center;
      gap: 8px;
      font-size: 12px;
      font-weight: 600;
      cursor: pointer;
      box-shadow: inset 0 1px 0 rgba(255,255,255,0.8);
      overflow: hidden;
      white-space: nowrap;
      text-overflow: ellipsis;
      transition: transform 150ms ease, box-shadow 150ms ease, filter 150ms ease;
    }

    .taskbar-btn:hover {
      transform: translateY(-1px);
      filter: brightness(1.02);
    }

    .taskbar-btn.active {
      background: linear-gradient(180deg, #fefefe 0%, #dfe9f7 100%);
      border-color: #7ea2d7;
      box-shadow: inset 0 0 0 1px rgba(125,158,219,0.7);
    }

    .taskbar-btn .tiny-icon {
      width: 14px; height: 14px;
      background: linear-gradient(180deg, #6eaefc, #1c63c3);
      border-radius: 2px;
      box-shadow: inset 0 0 0 1px rgba(0,0,0,0.25);
      flex-shrink: 0;
    }

    .tray {
      width: 120px;
      display: flex;
      align-items: center;
      justify-content: center;
      border-left: 1px solid rgba(0,0,0,0.3);
      font-size: 12px;
      font-weight: 600;
      color: #2a2a2a;
      background: linear-gradient(180deg, #e4e4e4 0%, #d5d5d5 100%);
      box-shadow: inset 1px 0 0 rgba(255,255,255,0.8);
    }

    /*
      Start menu styling: this dropdown appears from the taskbar and contains app launch shortcuts.
      It is hidden by default and shown only when toggled by the Start button.
    */
    .start-menu {
      position: absolute;
      left: 0;
      bottom: 52px;
      width: 320px;
      height: 430px;
      background: linear-gradient(180deg, #f1f1f1 0%, #dfdfdf 100%);
      border-top: 1px solid #fff;
      border-left: 1px solid #fff;
      border-right: 1px solid #6d6d6d;
      border-bottom: 1px solid #6d6d6d;
      box-shadow: 3px 3px 8px rgba(0,0,0,0.35);
      display: none;
      z-index: 100;
      overflow: hidden;
      transform-origin: left bottom;
    }

    .start-menu.open {
      display: block;
      animation: menuOpen 0.22s ease-out forwards;
    }

    .start-sidebar {
      position: absolute;
      left: 0;
      top: 0;
      bottom: 0;
      width: 38px;
      background: linear-gradient(180deg, #2a67bd 0%, #0d539b 100%);
      display: flex;
      align-items: center;
      justify-content: center;
      writing-mode: vertical-rl;
      transform: rotate(180deg);
      letter-spacing: 2px;
      color: #fff;
      font-weight: 700;
      font-size: 18px;
      text-shadow: 1px 1px 2px rgba(0,0,0,0.5);
    }

    .start-menu-content {
      margin-left: 38px;
      height: 100%;
      display: flex;
      flex-direction: column;
      padding: 8px 0 0;
      position: relative;
    }

    .menu-group {
      display: flex;
      flex-direction: column;
      gap: 2px;
      padding: 0 6px;
    }

    .menu-item {
      display: flex;
      align-items: center;
      gap: 12px;
      height: 34px;
      padding: 0 8px 0 10px;
      font-size: 13px;
      background: transparent;
      border: 1px solid transparent;
      cursor: pointer;
      user-select: none;
      transition: background 180ms ease, border-color 180ms ease, color 180ms ease, transform 180ms ease, padding-left 180ms ease;
    }

    .menu-item:hover {
      background: linear-gradient(180deg, #4b90eb 0%, #3f83d0 100%);
      border: 1px solid #345ba8;
      color: #fff;
      transform: translateX(2px);
      padding-left: 12px;
    }

    .menu-icon {
      width: 20px; height: 20px;
      background: linear-gradient(180deg, #fff, #d4d4d4);
      border: 1px solid rgba(0,0,0,0.35);
      border-radius: 3px;
      position: relative;
      overflow: hidden;
    }

    .menu-item:hover .menu-icon { background: linear-gradient(180deg, #f3f9ff, #d8e7ff); }

    /*
      Window styling: these are the floating application panels.
      They mimic classic desktop windows with a title bar, controls, and content area.
    */
    .window {
      position: absolute;
      width: 460px;
      min-height: 180px;
      background: linear-gradient(180deg, #f5f5f5 0%, #ececec 100%);
      border: 2px solid #1d4d93;
      box-shadow: 3px 3px 12px rgba(0,0,0,0.4);
      display: none;
      z-index: 20;
      overflow: hidden;
      transition: transform 180ms ease, box-shadow 180ms ease, opacity 180ms ease;
      transform-origin: center center;
    }

    .window.visible {
      display: block;
      animation: windowOpen 0.28s cubic-bezier(0.2, 0.8, 0.2, 1);
      box-shadow: 5px 8px 18px rgba(0,0,0,0.42);
    }

    .window.minimized {
      display: none !important;
    }

    .titlebar {
      background: linear-gradient(180deg, #2b6ed5 0%, #0d4ca8 100%);
      height: 32px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding-left: 10px;
      padding-right: 6px;
      color: white;
      font-weight: 700;
      font-size: 12px;
      cursor: move;
      user-select: none;
    }

    .titlebar .left {
      display: flex;
      align-items: center;
      gap: 8px;
      min-width: 0;
      overflow: hidden;
    }

    .titlebar .window-icon {
      width: 20px; height: 20px;
      background: linear-gradient(180deg, #dfefff, #a8d0ff);
      border-radius: 3px;
      border: 1px solid rgba(255,255,255,0.5);
      box-shadow: inset 0 0 0 1px rgba(0,0,0,0.2);
      flex-shrink: 0;
    }

    .titlebar .title-text {
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .window-controls {
      display: flex;
      gap: 2px;
    }

    .window-control {
      width: 24px; height: 18px;
      border: 1px solid rgba(255,255,255,0.75);
      background: linear-gradient(180deg, #f0f0f0, #d6d6d6);
      color: #111;
      font-weight: 700;
      font-size: 12px;
      cursor: pointer;
      display: grid;
      place-items: center;
      box-shadow: inset 0 1px 0 rgba(255,255,255,0.8);
    }

    .window-control:hover { filter: brightness(1.1); }

    .window-content {
      padding: 10px;
      background: linear-gradient(180deg, #f1f1f1 0%, #dfe7ef 100%);
      min-height: 120px;
      font-size: 13px;
    }

    /*
      The content-grid and panel classes structure the internal layout inside windows.
      These sections create two-column cards for explorer panes, system data, and project details.
    */
    .content-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 12px;
    }

    .panel {
      background: rgba(255,255,255,0.4);
      border: 1px solid #b9c8de;
      padding: 12px;
      min-height: 96px;
      box-shadow: inset 0 1px 0 rgba(255,255,255,0.6);
    }

    .panel h3 {
      margin: 0 0 10px;
      font-size: 15px;
    }

    .explorer-list {
      list-style: none; margin: 0; padding: 0; display: grid; gap: 8px;
    }

    .explorer-list li {
      display: flex; align-items: center; gap: 8px;
      padding: 4px 6px; background: rgba(255,255,255,0.3);
      border: 1px solid rgba(88,122,169,0.25);
    }

    .folder-badge {
      width: 16px; height: 14px; background: linear-gradient(180deg, #ffd967, #d5a63c);
      border-radius: 2px; border: 1px solid rgba(0,0,0,0.2);
    }

    .stats {
      display: grid; gap: 11px; margin-top: 10px;
    }

    .stat {
      display: flex; justify-content: space-between; align-items: center;
      padding: 5px 8px; background: rgba(255,255,255,0.35); border: 1px solid rgba(0,0,0,0.12);
    }

    .progress {
      width: 100%; height: 14px; background: #c9ced6; border: 1px solid #9399a7; position: relative; overflow: hidden;
      margin-top: 8px;
    }

    .progress > span {
      position: absolute; left: 0; top: 0; bottom: 0; width: 66%;
      background: linear-gradient(180deg, #7cc8ff, #2b8ee6);
      border-right: 1px solid rgba(0,0,0,0.2);
      animation: barLoad 1.8s ease-in-out infinite alternate;
    }

    .toolbar {
      display: flex;
      gap: 8px;
      padding: 8px 10px;
      background: linear-gradient(180deg, #eff4fb 0%, #dfe8f3 100%);
      border-bottom: 1px solid #b8c8dd;
    }

    .btn {
      border: 1px solid #7c9dbd;
      background: linear-gradient(180deg, #ffffff, #dfeaf7);
      color: #163d7d;
      padding: 6px 12px;
      font-size: 12px;
      font-weight: 600;
      cursor: pointer;
      box-shadow: inset 0 1px 0 rgba(255,255,255,0.8);
    }

    .btn:hover { filter: brightness(1.04); }

    .btn.primary {
      background: linear-gradient(180deg, #e4f6ff, #cfe7ff);
      border-color: #5c7fc2;
    }

    .status-area {
      margin-top: 10px;
      display: flex; gap: 8px; flex-wrap: wrap;
    }

    .status-tag {
      padding: 5px 10px; background: #eaf5ff; border: 1px solid #89b4e2; font-size: 12px;
    }

    .console {
      width: 100%; height: 200px; background: #0f1b2b; color: #c8f9d1; border: 1px solid #1c2e46; padding: 10px; overflow: auto; font-family: "Consolas", "Courier New", monospace; font-size: 12px; line-height: 1.45;
    }

    .console-line::before {
      content: "> ";
      color: #7ad8ff;
    }

    /*
      Game-specific styling: this section draws the map and quest cards used in the ARG game window.
      The map uses simple colored shapes to simulate terrain, and the character sits on top as a marker.
    */
    .game-layout {
      display: grid;
      grid-template-columns: 1.2fr 0.8fr;
      gap: 12px;
      align-items: start;
    }

    .game-card {
      background: rgba(255,255,255,0.38);
      border: 1px solid #b9c8de;
      padding: 12px;
      min-height: 140px;
    }

    .game-card h4 {
      margin: 0 0 10px; font-size: 14px;
    }

    .map {
      width: 100%; height: 160px; background: linear-gradient(180deg, #d8f0d8, #9ecb7b); border: 2px solid #3d7b39; position: relative; overflow: hidden;
    }

    .map::before {
      content: "";
      position: absolute; inset: 0;
      background-image:
        linear-gradient(rgba(255,255,255,0.1) 1px, transparent 1px),
        linear-gradient(90deg, rgba(255,255,255,0.08) 1px, transparent 1px);
      background-size: 22px 22px;
    }

    .terrain {
      position: absolute; border-radius: 999px; background: rgba(89, 133, 68, 0.7); box-shadow: inset 0 0 0 1px rgba(0,0,0,0.15);
    }

    .terrain.one { width: 120px; height: 90px; left: 28px; top: 26px; }
    .terrain.two { width: 130px; height: 80px; right: 20px; top: 56px; }
    .terrain.three { width: 90px; height: 90px; left: 110px; bottom: 12px; }

    .character {
      position: absolute;
      width: 18px; height: 18px; border-radius: 50%; background: linear-gradient(180deg, #ffec8e, #f3a735); border: 1px solid rgba(0,0,0,0.15);
      left: 135px; top: 72px;
      box-shadow: 0 0 0 2px rgba(255,255,255,0.25);
      animation: pulseGlow 1.8s ease-in-out infinite;
    }

    .terrain {
      animation: mapBob 4.2s ease-in-out infinite alternate;
    }

    .quest-list {
      list-style: none; margin: 0; padding: 0; display: grid; gap: 8px;
    }

    .quest-list li {
      display: flex; align-items: baseline; gap: 8px; background: rgba(255,255,255,0.35); padding: 6px 8px; border: 1px solid rgba(0,0,0,0.08);
    }

    .quest-list li::before { content: "▣"; color: #2a6cbf; }

    .textarea {
      width: 100%; min-height: 110px; resize: vertical; border: 1px solid #9aa6b9; padding: 8px; font-size: 12px; background: rgba(255,255,255,0.7);
    }

    /*
      Media query ensures the layout still looks good on smaller screens.
      It shrinks columns and keeps the windows readable on tablets or narrow browser widths.
    */
    @media (max-width: 840px) {
      .window { width: min(82vw, 420px); }
      .game-layout { grid-template-columns: 1fr; }
      .content-grid { grid-template-columns: 1fr; }
      .taskbar-btn { min-width: 110px; }
    }
  </style>
</head>
<body>
  <!--
    The desktop is the root area where icons and windows are placed.
    Each .window is a floating app or panel that can be opened, minimized, or closed.
  -->
  <div class="desktop">
    <div class="desktop-icons">
      <!--
        These desktop shortcuts act like launch buttons for the virtual desktop environment.
        Each icon uses data-window to point to its matching popup window.
      -->
      <div class="desktop-icon" data-window="explorer">
        <div class="icon-graphic icon-computer"></div>
        <span>My Computer</span>
      </div>
      <div class="desktop-icon" data-window="documents">
        <div class="icon-graphic icon-folder"></div>
        <span>Documents</span>
      </div>
