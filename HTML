  <!--
    The taskbar lives at the bottom of the page and hosts the main desktop actions.
    It provides the Start button, app buttons, and the live current time display.
  -->
  <div class="taskbar">
    <button class="start-button" id="startButton">start</button>
    <div class="taskbar-buttons" id="taskbarButtons"></div>
    <div class="tray" id="clock">00:00</div>
  </div>

  <script>
    //
    // JavaScript handles all desktop behavior, including window actions, taskbar updates,
    // and simple fake system interactions. This is the interactive layer that makes the page feel alive.
    //

    // Get all window elements so the app can open, close, and track them.
    const wins = [...document.querySelectorAll('.window')];
    const taskbarButtons = document.getElementById('taskbarButtons');
    const startMenu = document.getElementById('startMenu');
    const startButton = document.getElementById('startButton');
    const clock = document.getElementById('clock');

    // Updates the clock displayed in the bottom-right tray.
    // It uses the user's local time and refreshes once every second.
    function updateClock() {
      const now = new Date();
      clock.textContent = now.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
    }
    setInterval(updateClock, 1000);
    updateClock();

    // Opens a window by ID and makes it visible.
    // It sets the z-index so the active window sits on top of others.
    function openWindow(id) {
      const win = document.getElementById(id);
      if (!win) return;
      win.classList.add('visible');
      win.classList.remove('minimized');
      win.style.zIndex = String(20 + wins.indexOf(win) + 1);
      renderTaskbar();
    }

    // Closes a window by hiding it and marking it minimized.
    // The window is not removed from the DOM; it is simply hidden from view.
    function closeWindow(id) {
      const win = document.getElementById(id);
      if (!win) return;
      win.classList.remove('visible');
      win.classList.add('minimized');
      renderTaskbar();
    }

    // Minimizes a window by hiding it while keeping it in the taskbar.
    function minimizeWindow(id) {
      const win = document.getElementById(id);
      if (!win) return;
      win.classList.add('minimized');
      win.classList.remove('visible');
      renderTaskbar();
    }

    // Renders the taskbar buttons for all windows.
    // Each button shows the window title and toggles the window open or minimized when clicked.
    function renderTaskbar() {
      taskbarButtons.innerHTML = '';
      wins.forEach(win => {
        const id = win.id;
        const isVisible = win.classList.contains('visible');
        if (!isVisible && !win.classList.contains('minimized')) return;
        if (!win.classList.contains('visible') && win.classList.contains('minimized')) return;
        const btn = document.createElement('button');
        btn.className = 'taskbar-btn' + (isVisible ? ' active' : '');
        btn.innerHTML = '<span class="tiny-icon"></span><span>' + (win.dataset.title || id) + '</span>';
        btn.addEventListener('click', () => {
          if (win.classList.contains('visible')) {
            minimizeWindow(id);
          } else {
            openWindow(id);
          }
        });
        taskbarButtons.appendChild(btn);
      });
    }

    // Desktop icons open their matching windows when the user double-clicks them.
    // Single click also highlights the icon to give selection feedback.
    document.querySelectorAll('.desktop-icon').forEach(icon => {
      icon.addEventListener('dblclick', () => openWindow(icon.dataset.window));
      icon.addEventListener('click', () => {
        document.querySelectorAll('.desktop-icon').forEach(el => el.classList.remove('selected'));
        icon.classList.add('selected');
      });
    });

    // Clicking a menu item opens the chosen window and closes the start menu.
    document.querySelectorAll('.menu-item').forEach(item => {
      item.addEventListener('click', () => {
        const target = item.dataset.window;
        if (target) openWindow(target);
        startMenu.classList.remove('open');
      });
    });

    // The Start button toggles the menu open/closed.
    // Clicking outside the menu closes it as well.
    startButton.addEventListener('click', () => startMenu.classList.toggle('open'));
    document.addEventListener('click', (e) => {
      if (!startMenu.contains(e.target) && !startButton.contains(e.target)) {
        startMenu.classList.remove('open');
      }
    });

    // Window control buttons handle minimize and close actions.
    document.querySelectorAll('.window-control').forEach(btn => {
      btn.addEventListener('click', () => {
        const win = btn.closest('.window');
        const action = btn.dataset.action;
        if (!win) return;
        const id = win.id;
        if (action === 'close') closeWindow(id);
        if (action === 'minimize') minimizeWindow(id);
      });
    });

    // Dragging behavior lets the user move each window around the desktop.
    // The code records the click offset inside the window and updates its position as the mouse moves.
    wins.forEach((win, index) => {
      const titlebar = win.querySelector('.titlebar');
      let dragging = false;
      let offsetX = 0;
      let offsetY = 0;

      titlebar.addEventListener('mousedown', e => {
        dragging = true;
        const rect = win.getBoundingClientRect();
        offsetX = e.clientX - rect.left;
        offsetY = e.clientY - rect.top;
        win.style.zIndex = String(100 + index + 1);
      });

      document.addEventListener('mousemove', e => {
        if (!dragging) return;
        win.style.left = Math.max(0, Math.min(window.innerWidth - win.offsetWidth, e.clientX - offsetX)) + 'px';
        win.style.top = Math.max(0, Math.min(window.innerHeight - win.offsetHeight - 52, e.clientY - offsetY)) + 'px';
      });

      document.addEventListener('mouseup', () => { dragging = false; });
    });

    // The console is a fake terminal that appends new status lines periodically.
    // This creates the impression of a live system updating itself.
    const consoleEl = document.getElementById('console');
    const consoleLines = [
      'system online',
      'interface ready',
      'synced with ARG core',
      'awaiting user input',
      'status: project active',
      'recon package loaded',
      'sync check passed',
      'marker pulse stable'
    ];

    let consoleIndex = 0;
    setInterval(() => {
      if (!consoleEl) return;
      const line = document.createElement('div');
      line.className = 'console-line';
      line.textContent = consoleLines[consoleIndex % consoleLines.length];
      consoleEl.appendChild(line);
      consoleEl.scrollTop = consoleEl.scrollHeight;
      consoleIndex += 1;
    }, 3000);

    // On page load, the Welcome screen opens and the taskbar is generated.
    openWindow('welcome');
    renderTaskbar();
  </script>
